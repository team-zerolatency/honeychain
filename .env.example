# ==============================================================================
# HoneyChain Backend Environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
# Express server port
PORT=4000
# Runtime environment: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication / JWT
# ------------------------------------------------------------------------------
# Secrets used to sign access and refresh tokens
# Use strong, different secrets in production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Token expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------------------------
# URL of the Next.js frontend allowed to access the backend
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Next.js Public URLs
# ------------------------------------------------------------------------------
# URL of the Next.js frontend
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# URL of the Next.js backend
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL of the Next.js AI services
AI_SERVICE_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL database connection used by Prisma
DATABASE_URL="postgresql://honeychain:honeychain_dev@localhost:5432/honeychain"

# ------------------------------------------------------------------------------
# Blockchain - Hyperledger Besu
# ------------------------------------------------------------------------------
# Besu JSON-RPC endpoint
BESU_RPC_URL=http://127.0.0.1:8545
# Backend blockchain account private key
BESU_PRIVATE_KEY=0xYOUR_PRIVATE_KEY


# ------------------------------------------------------------------------------
# Smart Contract
# ------------------------------------------------------------------------------
# Address of the deployed HoneyChainRegistry contract
HONEYCHAIN_REGISTRY_ADDRESS=


# ------------------------------------------------------------------------------
# MQTT configuration
# ------------------------------------------------------------------------------
# Flag to enable or disable MQTT integration in the AI service
MQTT_ENABLED=false
# Broker URL for the MQTT server (default points to local broker on port 1883)
MQTT_BROKER_URL=mqtt://localhost:1883

# ------------------------------------------------------------------------------
# Chatbot Configuration
# ------------------------------------------------------------------------------
# Flag to enable or disable MQTT integration in the AI service
GROQ_API_KEY=
GROQ_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
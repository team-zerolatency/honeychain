# ==============================================================================
# HoneyChain Backend Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# The network port the Express HTTP server will listen on
PORT=4000

# Application environment runtime: 'development' | 'production' | 'test'
# Controls logging verbosity, stack traces, and caching behavior
NODE_ENV=development

# ------------------------------------------------------------------------------
# AUTHENTICATION & JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify short-lived Access Tokens (HMAC-SHA256)
# In production: replace with a high-entropy string (e.g. `openssl rand -base64 64`)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please

# Secret key used to sign and verify long-lived Refresh Tokens
# MUST be completely distinct from JWT_ACCESS_SECRET for security isolation
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-too

# Access Token lifetime (e.g., '15m', '1h', '300s')
# Short expiration reduces risk if a token is intercepted
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token lifetime (e.g., '7d', '30d')
# Used by the refresh rotation endpoint to issue new access tokens
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS & CLIENT INTEGRATION
# ------------------------------------------------------------------------------
# Allowed Frontend origin for Cross-Origin Resource Sharing (CORS) & cookies
# Matches your Next.js frontend dev server URL
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (POSTGRESQL + PRISMA)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://honeychain:honeychain_dev@localhost:5432/honeychain"